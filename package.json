{
  "name": "jpv",
  "version": "4.0.0",
  "description": "Tiny, fast, zero-dependency JSON pattern validation: describe the shape of your data with plain values, regexes, functions and logical operators. Detailed error paths, compiled validators and TypeScript types included.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "<5.0": {
      "*": [
        "dist/legacy/index.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "import": {
        "types@<5.0": "./dist/legacy/index.d.mts",
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types@<5.0": "./dist/legacy/index.d.cts",
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE.BSD"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=14"
  },
  "scripts": {
    "build": "node scripts/build.js",
    "test": "npm run build && node --test",
    "test:types": "npm run build && tsc --noEmit --strict --module nodenext --moduleResolution nodenext --target es2020 __tests__/types/usage.ts",
    "bench": "npm run build && node bench/index.js",
    "prepack": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mankhn/jpv.git"
  },
  "keywords": [
    "json",
    "pattern",
    "validator",
    "validation",
    "validate",
    "schema",
    "json-schema",
    "operators",
    "strict",
    "nullable",
    "regex",
    "array",
    "nested",
    "typescript",
    "zero-dependency"
  ],
  "author": "Manvel Khnkoyan",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/mankhn/jpv/issues"
  },
  "homepage": "https://github.com/mankhn/jpv#readme",
  "devDependencies": {
    "typescript": "~5.6.3"
  }
}
